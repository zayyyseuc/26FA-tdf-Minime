OPENROUTER_API_KEY=
# Model selection is a design decision. Verify the slug on openrouter.ai/models.
CHAT_MODEL=anthropic/claude-sonnet-4.5
EMBED_MODEL=openai/text-embedding-3-small
TEMPERATURE=0.5
TOP_K=5
CARD_FILE=system-card/v1.md
# Where publishable notes live (the dedicated Mini-Me vault)
CORPUS_SOURCE=/Users/chen/Mini-Me
# Optional: Slack/Feishu incoming webhook for "Leave a note for Zia". Without it, notes go to data/handoffs.jsonl and logs.
HANDOFF_WEBHOOK_URL=
PORT=3000
